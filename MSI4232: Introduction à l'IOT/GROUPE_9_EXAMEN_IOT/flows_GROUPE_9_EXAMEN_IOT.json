    {
        "id": "4c03116f733f81c2",
        "type": "function",
        "z": "b85658eb02c9c415",
        "name": "01 - Parser SALLE",
        "func": "let data = msg.payload.toString().trim();\n\n\n// Ignorer les messages système\nif(\n    data.includes(\"Station\") ||\n    data.includes(\"=\") ||\n    data==\"ERREUR_DHT\"\n){\n    return null;\n}\n\n\n// Découpage\nlet tab = data.split(\";\");\n\n\nif(tab.length !== 4)\n{\n    return null;\n}\n\n\nmsg.station = tab[0].trim();\n\nmsg.temperature = Number(tab[1]);\n\nmsg.humidite = Number(tab[2]);\n\nmsg.distance = Number(tab[3]);\n\n\n// debug\nnode.warn(\"STATION = \"+msg.station);\n\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 210,
        "y": 280,
        "wires": [
            [
                "d42b21175581f758"
            ]
        ]
    },
    {
        "id": "d42b21175581f758",
        "type": "function",
        "z": "b85658eb02c9c415",
        "name": "02 - Fonction règles métier",
        "func": "let presence = false;\n\nlet etat=\"VEILLE\";\n\n\nif(msg.distance < 40)\n{\n\n    presence=true;\n\n\n    if(\n        msg.temperature <=30 &&\n        msg.humidite <=75\n    )\n    {\n        etat=\"AUTORISE\";\n    }\n\n    else\n    {\n        etat=\"REFUSE\";\n    }\n\n}\n\nelse\n{\n\n    if(msg.temperature >28)\n    {\n        etat=\"PREALERTE\";\n    }\n\n    else\n    {\n        etat=\"VEILLE\";\n    }\n\n}\n\n\nmsg.presence = presence;\n\nmsg.etat = etat;\n\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 280,
