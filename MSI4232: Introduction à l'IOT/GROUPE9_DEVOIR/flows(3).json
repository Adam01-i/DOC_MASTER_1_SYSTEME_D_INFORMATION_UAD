    {
        "id": "d805a9faa6d802cc",
        "type": "function",
        "z": "e200bbfa8ca3b217",
        "name": "Funct : Traitement température",
        "func": "let ligne = msg.payload.trim();\n\nif (!ligne.startsWith(\"TEMP:\")) {\n    return null;\n}\n\nlet temp = parseFloat(ligne.replace(\"TEMP:\", \"\"));\n\nmsg.method = \"POST\";\nmsg.url = \"http://adam.alwaysdata.net/api/temperature.php?action=ajouter\";\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\n// PAS de JSON.stringify\nmsg.payload = {\n    valeur: temp\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
