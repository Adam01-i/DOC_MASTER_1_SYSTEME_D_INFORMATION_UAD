    {
        "id": "1eac99729bb605f7",
        "type": "function",
        "z": "e200bbfa8ca3b217",
        "name": "Function Serial",
        "func": "if (!msg.payload.success) {\n    return null;\n}\n\nlet l = msg.payload.data;\n\nlet trame = \"\";\n\nfor (let i = 0; i < l.length; i++) {\n    trame += (Number(l[i].etat) === 1) ? \"11\" : \"10\";\n}\n\nmsg.payload = trame + \"\\n\";\n\nreturn msg;",
        "outputs": 1,
