    {
        "id": "17e4a9f2703fa039",
        "type": "function",
        "z": "b85658eb02c9c415",
        "name": "04 - Function SQL INSERT",
        "func": "msg.topic = `\n\nINSERT INTO mesures\n(\nstation_id,\ntemperature,\nhumidite,\ndistance,\npresence,\netat\n)\n\nVALUES\n\n(\n(\nSELECT id \nFROM stations \nWHERE nom_station='${msg.station}'\n),\n\n${msg.temperature},\n\n${msg.humidite},\n\n${msg.distance},\n\n${msg.presence ? 1 : 0},\n\n'${msg.etat}'\n\n)\n\n`;\n\nreturn msg;",
